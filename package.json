{
  "name": "rquest",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test src/domain/progression.test.ts",
    "test:e2e": "node scripts/e2e.mjs",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm build:pages",
    "test:e2e:challenges": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/e2e-challenges.mjs",
    "test:validators": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/validator-selftest.mjs",
    "build:pages": "NEXT_PUBLIC_BASE_PATH=/rquest next build",
    "test:e2e:lessons": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/e2e-lessons.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "clsx": "^2.1.1",
    "lucide-react": "^1.72.0",
    "motion": "^14.12.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "playwright-core": "^1.65.0",
    "tailwindcss": "4.3.3",
    "typescript": "^5"
  },
  "packageManager": "pnpm@11.20.0"
}